DATABASE_URL="postgresql://user:password@localhost:5432/fashion_shop?schema=public"
AUTH_SECRET="generate-a-random-32-byte-base64-string"
# Bắt buộc để upload ảnh sản phẩm (Vercel Blob) — tạo tại tab Storage của
# project trên vercel.com, hoặc bỏ trống nếu chỉ dùng "dán URL ảnh" ở local.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
# Bắt buộc để chatbot AI (trợ lý CSKH) hoạt động — lấy API key miễn phí tại
# https://aistudio.google.com/apikey (chỉ cần tài khoản Google, không cần thẻ)
GOOGLE_GENERATIVE_AI_API_KEY="AIza..."
